function displayResult() {
    let score = 0;

    const answers = document.querySelectorAll(".selected");

    answers.forEach(answer => {
        score += Number(answer.dataset.points);
    });

    const resultContainer = document.getElementById("result-container");

    if (score <= 5) {
        resultContainer.textContent =
            "You are Rock Music! You are energetic and adventurous.";
    } else {
        resultContainer.textContent =
            "You are Classical Music! You are thoughtful and creative.";
    }
}

document
    .getElementById("show-results")
    .addEventListener("click", displayResult);
